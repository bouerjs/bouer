{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "target": "es2017",
    "moduleResolution": "Node",
    "lib": ["ES2016", "ES2017", "DOM"],
    "isolatedModules": false,
    "esModuleInterop": false,
		"emitDeclarationOnly": false,
    "outDir": "types",
		"declaration": false,
    "strictNullChecks": true,
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
		"node_modules",
		"dist"
	],
  "include": ["./src/**/*"]
}