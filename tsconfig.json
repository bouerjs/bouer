{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "target": "es2017",
    "lib": ["ES2016", "ES2017", "ESNext", "DOM"],
    "isolatedModules": false,
		"emitDeclarationOnly": false,
    "outDir": "dist",
		"declaration": false,
    "strictNullChecks": true
  },
  "exclude": [
		"node_modules",
		"dist"
	],
  "include": ["./src/**/*"]
}