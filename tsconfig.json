{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "isolatedModules": false,
    "esModuleInterop": false,
		"emitDeclarationOnly": false,
    "outDir": "types",
		"declaration": false,
    "strictNullChecks": true
  },
  "exclude": [
		"node_modules",
		"dist"
	],
  "include": ["./src/**/*"]
}

