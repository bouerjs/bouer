{
  "name": "bouerjs",
  "version": "3.3.0",
  "description": "A library that provides a fastest and easy way to bind data to your pages",
  "main": "dist/bouer.common.min.js",
  "bin": "dist/bouer.common.min.js",
  "module": "dist/bouer.esm.min.js",
  "typings": "types/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "jest --detectOpenHandles",
    "dev": "rollup --config rollup.config.js --w",
    "dev:r": "node scripts/build.js --dev",
    "build": "rollup --config rollup.config.js",
    "build:main:": "node scripts/build.js",
    "build+min": "node scripts/build.js --prod",
    "pack": "node scripts/build.js --prod && npm pack",
    "prepare": "husky",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s"
  },
  "files": [
    "src",
    "dist/*.js",
    "types/*.d.ts"
  ],
  "keywords": [
    "bouer",
    "bouerjs",
    "bouer.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouerjs/bouer.git"
  },
  "bugs": {
    "url": "https://github.com/bouerjs/bouer/issues"
  },
  "homepage": "https://bouerjs.github.io/",
  "author": {
    "name": "Afonso Matumona",
    "email": "afonsomatumona@hotmail.com",
    "url": "https://github.com/afonsomatelias"
  },
  "license": "MIT License",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "js-beautify": "^2.0.3",
    "rollup": "^4.30.0",
    "terser": "^5.37.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
